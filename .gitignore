# Python-generated files
__pycache__/
*.py[oc]
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.python-version

# The pulled Euro-Office payload the POC used. Nothing reads it any more;
# everything comes from build/ now.
vendor/

# build/ is our Euro-Office build script and patch queue, not an artefact
# directory -- uv_build never writes one. Un-ignore it: the usual global
# gitignore carries /build/ from the setuptools era, which would swallow it.
!/build/
/etc/

# What the libera wheel carried up to 0.7.1, which nothing reads now. Still
# ignored: a checkout that has one, a builder's among them, would otherwise
# count as dirty and be refused.
src/libera/manifest.json

# Built documentation (docs/Makefile)
/docs/site/
# Generated by docs/preprocess.py
/docs/src/news/
/docs/i18n/*/news/
/docs/i18n/*/assets/
/docs/zensical.*.toml
/docs/.cache/
/notes/pdf/

# The macOS application bundle (build/macos/macos-app.sh)
/build/out/

# Written by `uv run pytest --cov=libera`, and committed once by accident.
.coverage
htmlcov/

.hop3-local.toml
