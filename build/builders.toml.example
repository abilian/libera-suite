# The machines that build a core. Copy to build/builders.toml.
#
# That copy is gitignored: it is an inventory of build hosts, and a public
# repository is the wrong place for one.

[defaults]
# The checkout on each builder; it can be overridden per builder below. It
# builds the commit the driving checkout is at, which `update` sends it over
# ssh: no branch to name, nothing to push first.
repo = "~/liberasuite"

[[builders]]
# platform is what it builds for, and names the libera-core wheel and the
# bundle fetched from it: macos-arm64, macos-x86_64, linux-x86_64,
# linux-arm64, windows-x86_64.
platform = "macos-arm64"
# target is anything scp takes, or "local" for this machine. Give it a Host in
# ~/.ssh/config and put the alias here: a key, a port and a jump host belong in
# ssh's own configuration, not in a build script's.
target = "local"

[[builders]]
platform = "linux-x86_64"
target = "builder-amd64"

[[builders]]
platform = "linux-arm64"
target = "builder-arm64"

[[builders]]
# Reached over OpenSSH, its shell Git Bash; `ship` builds its core and the
# installer there with `components build` and `app build windows` (see
# docs/src/develop/build.md, Windows). C:/b is the build root there
# (engine/common.sh).
platform = "windows-x86_64"
target = "builder-windows"
