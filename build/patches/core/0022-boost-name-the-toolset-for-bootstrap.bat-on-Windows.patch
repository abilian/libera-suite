From 7f732f7d2ee74bd844acc461faf1a9592836c736 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Mon, 21 Sep 2026 10:16:55 +0200
Subject: [PATCH] boost: name the toolset for bootstrap.bat on Windows

build.bat runs vswhere itself and maps the Visual Studio *installation* to
a toolset name, so on anything newer than it knows it answers "Unknown
toolset: vcunk" and stops -- whatever cl.exe is on PATH. Measured on
Visual Studio 18 with the 14.29 toolset active: the compiler was right and
boost never looked at it.

`msvc` is what build.bat's own error message suggests, and it means the cl
on PATH, which is the one the caller has already arranged. It goes before
--prefix, since bootstrap.bat takes the toolset as its first non-switch
argument.

The same line was concatenating "/c" and "bootstrap.bat" into one argument
through a missing comma. cmd accepts \`/cbootstrap.bat\`, so it worked; it is
separated here because the argument list was being edited anyway.
---
 Common/3dParty/boost/nc-build.py | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/Common/3dParty/boost/nc-build.py b/Common/3dParty/boost/nc-build.py
index 91e0f90ff2..fe303154aa 100644
--- a/Common/3dParty/boost/nc-build.py
+++ b/Common/3dParty/boost/nc-build.py
@@ -84,8 +84,21 @@ def build_and_install():
     elif nc.is_windows():
         boost_arch, host_subdir = boost_msvc_arch()
 
+        # `msvc`, and not left to bootstrap.bat's own detection.
+        #
+        # build.bat runs vswhere itself and maps the *installation* to a
+        # toolset name, so on a Visual Studio newer than it knows it answers
+        # "Unknown toolset: vcunk" and stops -- whatever cl.exe is on PATH.
+        # Measured on Visual Studio 18 with the 14.29 toolset active: the
+        # compiler was right and boost never looked at it.
+        #
+        # `msvc` is the spelling build.bat's own error message suggests, and it
+        # means "the cl on PATH", which is the one the caller has already
+        # arranged. It has to come before --prefix: bootstrap.bat reads the
+        # toolset as its first non-switch argument.
         nc.run_command(
-            [ "cmd.exe", "/c" "bootstrap.bat", f"--prefix={ nc.install_dir }" ],
+            [ "cmd.exe", "/c", "bootstrap.bat", "msvc",
+              f"--prefix={ nc.install_dir }" ],
             "Running bootstrap",
             nc.work_dir
         )
-- 
