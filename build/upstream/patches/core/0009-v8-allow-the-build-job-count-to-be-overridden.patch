From 22e630b10bbebf7c07f656050edd090ccb23b884 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Thu, 10 Sep 2026 15:27:28 +0200
Subject: [PATCH] v8: allow the build job count to be overridden

The job count is fixed at one per core with a floor of four and no way to
lower it. Linking v8_monolith is memory-hungry, so eight parallel clang
processes on a 16 GB machine get the build OOM-killed. Honour
V8_BUILD_JOBS when set.
---
 Common/3dParty/v8/nc-build.py | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Common/3dParty/v8/nc-build.py b/Common/3dParty/v8/nc-build.py
index 1c51cfbcc7..a8d07b68a1 100644
--- a/Common/3dParty/v8/nc-build.py
+++ b/Common/3dParty/v8/nc-build.py
@@ -488,6 +488,10 @@ def _available_memory() -> int | None:
     return min( limits ) if limits else None
 
 def _job_count() -> int:
+    # Set by the caller when it knows better, as on a laptop that also has
+    # to stay usable while V8 builds.
+    if os.environ.get( "V8_BUILD_JOBS" ):
+        return int( os.environ[ "V8_BUILD_JOBS" ] )
     # V8's compile jobs need up to ~2 GB each. One job per CPU gets runners
     # with many cores and little memory OOM-killed.
     jobs = os.cpu_count() or 1
-- 
2.55.0

