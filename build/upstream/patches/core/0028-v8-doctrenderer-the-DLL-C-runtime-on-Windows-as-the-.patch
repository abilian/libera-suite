From f68d75a64f173982a2312386d74d7036f91bd800 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Thu, 19 Nov 2026 20:12:33 +0100
Subject: [PATCH] v8, doctrenderer: the DLL C runtime on Windows, as the rest
 of core

Chromium links the static C runtime into every non-component desktop
build, and doctrenderer asked for the static one to match. Core is built
against the DLL runtime, and so is an OpenSSL from vcpkg's static-md
triplet: doctrenderer.dll pulled in libucrt.lib and could not resolve
libcrypto's __imp__time64, __imp_strspn and three more (LNK1120). Core's
libraries also hand FILE* handles to one another, which needs one
runtime. There is no gn arg for it, so build/config/win/BUILD.gn is
patched like the functor fix, the version names the runtime on Windows
so that a V8 built before is built again, and doctrenderer takes the DLL
runtime common.cmake gives every other target.
---
 Common/3dParty/v8/nc-build.py             | 25 ++++++++++++++++++++++-
 DesktopEditor/doctrenderer/CMakeLists.txt |  2 +-
 2 files changed, 25 insertions(+), 2 deletions(-)

diff --git a/Common/3dParty/v8/nc-build.py b/Common/3dParty/v8/nc-build.py
index eeabe484ec..bfc8f49f70 100644
--- a/Common/3dParty/v8/nc-build.py
+++ b/Common/3dParty/v8/nc-build.py
@@ -29,7 +29,9 @@ nc.init_for_dep(
     workdir = Path( sys.argv[1] ).resolve(),
     installdir = Path( sys.argv[2] ).resolve(),
     forceredo = len(sys.argv) > 3 and sys.argv[3] == "force-redo",
-    version = V8_VERSION
+    # On Windows the version also names the C runtime, so that a V8 built
+    # against the static one before patch_dynamic_crt is built again.
+    version = V8_VERSION + ( "-dynamic-crt" if nc.is_windows() else "" )
 )
 
 depot_tools_path = nc.work_dir / "depot_tools"
@@ -144,6 +146,26 @@ def disable_crel():
         nc.abort_op( f"Could not find the CREL flags in { compiler_gn_path }. Did the V8 build config change?" )
     compiler_gn_path.write_text( text.replace( crel_flags, marker ) )
 
+def patch_dynamic_crt():
+    # Chromium links the static C runtime into every non-component desktop
+    # build, and V8's library tells the linker so. Core is built against the
+    # DLL runtime (common.cmake), as is an OpenSSL from vcpkg's static-md
+    # triplet, so doctrenderer.dll then pulled in libucrt.lib and could not
+    # resolve libcrypto's __imp__time64, __imp_strspn and the rest (LNK1120).
+    # Core's libraries also hand FILE* handles to one another, which needs one
+    # runtime. There is no gn arg for it; take the dynamic one here.
+    build_gn_path = v8_src_path / "build" / "config" / "win" / "BUILD.gn"
+    text = build_gn_path.read_text()
+    original = """      # Desktop Windows: static CRT.
+      configs = [ ":static_crt" ]"""
+    patched = """      # Desktop Windows: the DLL CRT, as the rest of core (nc-build.py).
+      configs = [ ":dynamic_crt" ]"""
+    if patched in text:
+        return
+    if original not in text:
+        nc.abort_op( f"Could not find the static CRT choice in { build_gn_path }. Did Chromium's build change?" )
+    build_gn_path.write_text( text.replace( original, patched ) )
+
 def patch_callable_run_type():
     # V8 extracts a functor's signature from &Functor::operator(), expecting a
     # member of Functor itself. MSVC's std::function inherits its operator()
@@ -565,6 +587,7 @@ def build_and_install():
         disable_crel()
     if nc.is_windows():
         patch_callable_run_type()
+        patch_dynamic_crt()
 
     targetarch = get_cpu()
     output_path = v8_src_path / "out.gn" / f"{targetarch}.release"
diff --git a/DesktopEditor/doctrenderer/CMakeLists.txt b/DesktopEditor/doctrenderer/CMakeLists.txt
index ab0b3b12ed..577e621c6e 100644
--- a/DesktopEditor/doctrenderer/CMakeLists.txt
+++ b/DesktopEditor/doctrenderer/CMakeLists.txt
@@ -121,7 +121,7 @@ add_library(doctrenderer SHARED
 set_default_options(doctrenderer)
 
 if( MSVC )
-    set_property(TARGET doctrenderer PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
+    # The DLL runtime, as the rest of core (common.cmake) and V8 (nc-build.py).
 
     target_compile_definitions( doctrenderer PRIVATE
         _UNICODE
-- 
2.55.0

