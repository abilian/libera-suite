From 9efad2f655751523b87c402d9b937cfe176b8f91 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Tue, 27 Oct 2026 17:42:53 +0100
Subject: [PATCH] v8: clone the 8.9.45 tag alone

V8's history is 2 GB of the build tree and nothing builds from it.
The fetch before the build went too: the checkout is the tag, and a
fetch could only bring commits nobody checks out.
---
 Common/3dParty/v8/nc-build.py | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/Common/3dParty/v8/nc-build.py b/Common/3dParty/v8/nc-build.py
index da57e55332..5168b68a08 100644
--- a/Common/3dParty/v8/nc-build.py
+++ b/Common/3dParty/v8/nc-build.py
@@ -941,8 +941,11 @@ def fetch_and_patch():
 
     # Fetch v8
     print( "Fetching v8" )
-    nc.run_command( [ "git", "clone", "https://chromium.googlesource.com/v8/v8.git", v8_src_path ], "Clone v8" )
-    nc.run_command( [ "git", "checkout", "8.9.45" ], "Git checkout 8.9.45", v8_src_path )
+    # The tag alone: V8's history is 2 GB, and nothing builds from it.
+    nc.run_command(
+        [ "git", "clone", "--depth", "1", "--branch", "8.9.45", "https://chromium.googlesource.com/v8/v8.git", v8_src_path ],
+        "Clone v8 8.9.45"
+    )
 
     nc.create_work_dir_ok_marker()
 
@@ -964,7 +967,6 @@ def build_and_install():
     # Clean v8 state
     nc.run_command( [ "git", "reset", "--hard" ], "Git reset", v8_src_path )
     nc.run_command( [ "git", "clean", "-fdx" ], "Git clean", v8_src_path )
-    nc.run_command( [ "git", "fetch", "origin" ], "Git fetch", v8_src_path )
 
     if nc.is_apple_silicon():
         disable_luci_go_cipd_dep()
-- 
2.55.0

