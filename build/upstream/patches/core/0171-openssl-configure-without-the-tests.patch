From 403cdd56fb22a8b016952305e1cbf20d335c7114 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Tue, 27 Oct 2026 17:42:53 +0100
Subject: [PATCH 171/171] openssl: configure without the tests

make builds about three hundred test programs, each with libcrypto
linked in statically: 1.2 GB that nothing runs, beside libraries the
core links against that take a few megabytes.
---
 Common/3dParty/openssl/nc-build.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Common/3dParty/openssl/nc-build.py b/Common/3dParty/openssl/nc-build.py
index 2114bc342d..41f7917fc7 100644
--- a/Common/3dParty/openssl/nc-build.py
+++ b/Common/3dParty/openssl/nc-build.py
@@ -59,6 +59,7 @@ def build_and_install():
                 "--libdir=lib64",
                 "enable-md2",
                 "no-shared",
+                "no-tests",
                 "no-asm",
             ],
             "Configure",
@@ -84,6 +85,7 @@ def build_and_install():
                 f"--openssldir={nc.install_dir}",
                 "enable-md2",
                 "no-shared",
+                "no-tests",
             ],
             "Configure",
             nc.work_dir
@@ -111,6 +113,7 @@ def build_and_install():
                 f"--openssldir={nc.install_dir}",
                 "enable-md2",
                 "no-shared",
+                "no-tests",
                 "no-asm",
             ],
             "Configure",
-- 
