From e87f321e59d012eafbdcac6ddf206efc8404a152 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sfermigier@gmail.com>
Date: Fri, 30 Oct 2026 07:28:47 +0100
Subject: [PATCH] pdf: a moved page keeps what it inherits from its own parents

After an earlier move, the page at a position is not the original's page
at that index, but its inherited MediaBox, CropBox and Rotate were read
from the latter. From ElixirOffice's
pdf-page-order-inherited-attributes (leag1234/elixiroffice@ac630a1).
---
 PdfFile/PdfEditor.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/PdfFile/PdfEditor.cpp b/PdfFile/PdfEditor.cpp
index 9954c81ced..4fdf022916 100644
--- a/PdfFile/PdfEditor.cpp
+++ b/PdfFile/PdfEditor.cpp
@@ -2039,7 +2039,14 @@ bool CPdfEditor::EditPage(int _nPageIndex, bool bSet, bool bActualPos)
 		return false;
 	std::pair<int, int> pPageRef = std::make_pair(0, 0);
 	if (bActualPos)
+	{
 		pPageRef = pDoc->GetPageRef(_nPageIndex);
+		// After a move the page at this position is not the original's page at
+		// this index, and what it inherits comes from its own parents.
+		nPageIndex = pCatalog->findPage(pPageRef.first, pPageRef.second);
+		if (nPageIndex < 1)
+			return false;
+	}
 	else
 	{
 		Ref* pRef = pPDFDocument->getCatalog()->getPageRef(nPageIndex);
-- 
2.55.0

