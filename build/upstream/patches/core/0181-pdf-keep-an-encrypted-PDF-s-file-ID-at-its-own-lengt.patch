From 66a8802d0e85c7ef6421b3ffafbcae9c4f0bb75e Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sfermigier@gmail.com>
Date: Fri, 30 Oct 2026 18:06:00 +0100
Subject: [PATCH 181/182] pdf: keep an encrypted PDF's file ID at its own
 length

The key of every encryption but AES-256 is computed over the first file
ID, which the writer copied into 16 bytes while counting its full
length. pypdf writes 32, so a comment on a PDF it encrypted with RC4 or
AES-128 could not be saved.
---
 PdfFile/SrcWriter/Document.cpp          |  8 ++++----
 PdfFile/SrcWriter/Encrypt.cpp           | 13 ++++++-------
 PdfFile/SrcWriter/Encrypt.h             | 12 +++++++++---
 PdfFile/SrcWriter/EncryptDictionary.cpp |  6 +++---
 4 files changed, 22 insertions(+), 17 deletions(-)

diff --git a/PdfFile/SrcWriter/Document.cpp b/PdfFile/SrcWriter/Document.cpp
index 09b3b333e9..188358935a 100644
--- a/PdfFile/SrcWriter/Document.cpp
+++ b/PdfFile/SrcWriter/Document.cpp
@@ -371,14 +371,14 @@ namespace PdfWriter
 		else
 			pID->Clear();
 
-		pID->Add(new CBinaryObject(pEncrypt->m_anEncryptID, 16));
-		pID->Add(new CBinaryObject(pEncrypt->m_anEncryptID, 16));
+		pID->Add(new CBinaryObject(pEncrypt->m_anEncryptID.data(), 16));
+		pID->Add(new CBinaryObject(pEncrypt->m_anEncryptID.data(), 16));
 
 		if (m_pMetaData)
-			m_pMetaData->SetID(new CBinaryObject(pEncrypt->m_anEncryptID, 16));
+			m_pMetaData->SetID(new CBinaryObject(pEncrypt->m_anEncryptID.data(), 16));
 
 		for (int i = 0; i < m_vMetaOForms.size(); ++i)
-			m_vMetaOForms[i]->Add("ID", new CBinaryObject(pEncrypt->m_anEncryptID, 16));
+			m_vMetaOForms[i]->Add("ID", new CBinaryObject(pEncrypt->m_anEncryptID.data(), 16));
 	}
     void CDocument::SetPasswords(const std::wstring & wsOwnerPassword, const std::wstring & wsUserPassword)
 	{
diff --git a/PdfFile/SrcWriter/Encrypt.cpp b/PdfFile/SrcWriter/Encrypt.cpp
index 48ccb8a650..1ca05473c9 100644
--- a/PdfFile/SrcWriter/Encrypt.cpp
+++ b/PdfFile/SrcWriter/Encrypt.cpp
@@ -195,8 +195,7 @@ namespace PdfWriter
 		
 		m_unPermission = ENABLE_PRINT | ENABLE_EDIT_ALL | ENABLE_COPY | ENABLE_EDIT | PERMISSION_PAD;
 		
-		MemSet(m_anEncryptID, 0, ID_LEN);
-		m_unIDLength = ID_LEN;
+		m_anEncryptID.assign(ID_LEN, 0);
 
 		MemSet(m_anOwnerKey, 0, 48);
 		MemSet(m_anUserKey, 0, 48);
@@ -392,7 +391,7 @@ namespace PdfWriter
         int nLen = nLength;
         bool bResult = true;
 
-        unsigned char* pBuffer = new unsigned char[72 + m_unIDLength];
+        unsigned char* pBuffer = new unsigned char[72 + m_anEncryptID.size()];
 
         if (nLen < 32)
         {
@@ -409,8 +408,8 @@ namespace PdfWriter
         pBuffer[66] = (m_unPermission >> 16) & 0xff;
         pBuffer[67] = (m_unPermission >> 24) & 0xff;
 
-        memcpy(pBuffer + 68, m_anEncryptID, m_unIDLength);
-        nLen = 68 + m_unIDLength;
+        memcpy(pBuffer + 68, m_anEncryptID.data(), m_anEncryptID.size());
+        nLen = 68 + m_anEncryptID.size();
         if (!true)
         {
             pBuffer[nLen++] = 0xff;
@@ -445,9 +444,9 @@ namespace PdfWriter
                 rc4Decryption.ProcessData(sTest, sTest, 32);
             }
             memcpy(pBuffer, passwordPad, 32);
-            memcpy(pBuffer + 32, m_anEncryptID, m_unIDLength);
+            memcpy(pBuffer + 32, m_anEncryptID.data(), m_anEncryptID.size());
 
-            MD5(pBuffer, 32 + m_unIDLength, pBuffer);
+            MD5(pBuffer, 32 + m_anEncryptID.size(), pBuffer);
 
             bResult = (memcmp(sTest, pBuffer, 16) == 0);
         }
diff --git a/PdfFile/SrcWriter/Encrypt.h b/PdfFile/SrcWriter/Encrypt.h
index 04ae18819c..e681427835 100644
--- a/PdfFile/SrcWriter/Encrypt.h
+++ b/PdfFile/SrcWriter/Encrypt.h
@@ -27,6 +27,8 @@
 
 #include "Utils.h"
 
+#include <vector>
+
 #define ID_LEN              16
 #define PERMISSION_PAD      0xFFFFFFC0
 
@@ -60,7 +62,12 @@ namespace PdfWriter
         void SetPasswords(const std::string &sUserPassword, const std::string &sOwnerPassword);
         bool MakeFileKey(int nCryptAlgorithm);
 
-        SET_BYTE_FUNC(SetID, m_anEncryptID);
+        // The ID a PDF gives is as long as its writer chose; 16 bytes only
+        // when this writer makes one.
+        void SetID(const BYTE* pSrc, unsigned int unLen)
+        {
+            m_anEncryptID.assign(pSrc, pSrc + unLen);
+        }
         SET_BYTE_FUNC(SetO,  m_anOwnerKey);
         SET_BYTE_FUNC(SetU,  m_anUserKey);
         SET_BYTE_FUNC(SetOE, m_anOwnerEncryptKey);
@@ -88,8 +95,7 @@ namespace PdfWriter
         unsigned int    m_unVersion;                //V
         unsigned int    m_unRevision;               //R
 
-        BYTE            m_anEncryptID[ID_LEN];
-        unsigned int    m_unIDLength;
+        std::vector<BYTE> m_anEncryptID;
 
 		friend class CEncryptDict;
 		friend class CDocument;
diff --git a/PdfFile/SrcWriter/EncryptDictionary.cpp b/PdfFile/SrcWriter/EncryptDictionary.cpp
index e649ef59a7..c7802158ba 100644
--- a/PdfFile/SrcWriter/EncryptDictionary.cpp
+++ b/PdfFile/SrcWriter/EncryptDictionary.cpp
@@ -64,10 +64,9 @@ namespace PdfWriter
 		SET_BINARY_PARAM("OE", SetOE, 32);
 		SET_BINARY_PARAM("UE", SetUE, 32);
 		SET_BINARY_PARAM("Perms", SetPerms, 16);
-		SET_BINARY_PARAM("ID", SetID, 16);
         pObj = Get("ID");
         if (pObj && pObj->GetType() == object_type_BINARY)
-            m_pEncrypt->m_unIDLength = ((CBinaryObject*)pObj)->GetLength();
+            m_pEncrypt->SetID(((CBinaryObject*)pObj)->GetValue(), ((CBinaryObject*)pObj)->GetLength());
         Remove("ID");
 
         SET_NUMBER_PARAM("P", SetPermission);
@@ -151,7 +150,8 @@ namespace PdfWriter
 	}
 	void CEncryptDict::Prepare(CInfoDict* pInfo, CXref* pXref)
 	{
-		CreateId(pInfo, pXref, (BYTE*)m_pEncrypt->m_anEncryptID);
+		m_pEncrypt->m_anEncryptID.assign(ID_LEN, 0);
+		CreateId(pInfo, pXref, m_pEncrypt->m_anEncryptID.data());
 		
         m_pEncrypt->CreateEncryptionKey();
         m_pEncrypt->CreateUserKey();
-- 
