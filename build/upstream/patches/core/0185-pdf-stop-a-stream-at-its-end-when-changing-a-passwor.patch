From 7cb4e064c9c2aaf20a659d49284cf69129751d96 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sfermigier@gmail.com>
Date: Sat, 31 Oct 2026 20:49:15 +0100
Subject: [PATCH] pdf: stop a stream at its end when changing a password

_ChangePassword copied as many bytes as the stream's Length, the length
of its ciphertext. An AES stream decrypts to fewer, and getChar made up
the difference with EOF, written as 0xFF: changing or removing an AES
PDF's password padded every stream, its metadata included. It now stops
at the Length or at the end of the stream, whichever comes first.
---
 PdfFile/PdfEditor.cpp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/PdfFile/PdfEditor.cpp b/PdfFile/PdfEditor.cpp
index 49a05ed514..db628d855d 100644
--- a/PdfFile/PdfEditor.cpp
+++ b/PdfFile/PdfEditor.cpp
@@ -741,10 +741,16 @@ HRESULT ChangePdfPassword(const std::wstring& wsPath, const std::wstring& wsPass
 			PdfWriter::CStream* pStream = new PdfWriter::CMemoryStream();
 			pDObj->SetStream(m_pXref, pStream, false);
 
+			// To its Length or to the end of the stream, whichever comes first.
+			// The Length is the ciphertext's, and an AES stream decrypts to fewer
+			// bytes (its IV and padding gone), which getChar made up with EOF,
+			// written as 0xFF. The end alone is no bound: where a wrong Length
+			// misses "endstream", the parser adds 5000 bytes to it.
 			Stream* pImage = oTemp.getStream()->getUndecodedStream();
 			pImage->reset();
-			for (int nI = 0; nI < nLength; ++nI)
-				pStream->WriteChar(pImage->getChar());
+			int nC = 0;
+			for (int nI = 0; nI < nLength && (nC = pImage->getChar()) != EOF; ++nI)
+				pStream->WriteChar(nC);
 			break;
 		}
 		case objNone:
-- 
