From afca289bde9a3552a847be31b515ef9a1c405a3f Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sfermigier@gmail.com>
Date: Sat, 31 Oct 2026 20:49:15 +0100
Subject: [PATCH] pdf: say in /Perms that metadata is encrypted

The writer encrypts the metadata stream with the rest and writes no
/EncryptMetadata, which then means true, but /Perms said 'F'. Readers
that check it, pypdf among them, report the file's permissions as
failing verification.
---
 PdfFile/SrcWriter/Encrypt.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/PdfFile/SrcWriter/Encrypt.cpp b/PdfFile/SrcWriter/Encrypt.cpp
index f59d081ab5..ee65ef3eff 100644
--- a/PdfFile/SrcWriter/Encrypt.cpp
+++ b/PdfFile/SrcWriter/Encrypt.cpp
@@ -554,7 +554,9 @@ namespace PdfWriter
 			m_anPermEncrypt[i] = static_cast<unsigned char>(extended_perms & 0xff);
 			extended_perms >>= 8;
 		}
-		m_anPermEncrypt[8]	= /*m_bEncryptMetadata ? 'T' : */'F';
+		// 'T': the metadata stream is encrypted with the rest, as /EncryptMetadata,
+		// which is not written, says by default. 'F' contradicted it.
+		m_anPermEncrypt[8]	= 'T';
 		m_anPermEncrypt[9]	= 'a';
 		m_anPermEncrypt[10]	= 'd';
 		m_anPermEncrypt[11]	= 'b';
-- 
