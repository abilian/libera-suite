From b55efc5a38bc3171f553de3c650c7376592d3bcb Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sfermigier@gmail.com>
Date: Sat, 31 Oct 2026 21:03:41 +0100
Subject: [PATCH] pdf: leave the old encryption dictionary out when changing a
 password

_ChangePassword copied every object of the original, its encryption
dictionary too, which then stayed in the file unreferenced, its strings
encrypted a second time; each change of password added another.
---
 PdfFile/PdfEditor.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/PdfFile/PdfEditor.cpp b/PdfFile/PdfEditor.cpp
index db628d855d..35fecdc5de 100644
--- a/PdfFile/PdfEditor.cpp
+++ b/PdfFile/PdfEditor.cpp
@@ -609,10 +609,18 @@ HRESULT ChangePdfPassword(const std::wstring& wsPath, const std::wstring& wsPass
 	}
 	pXref->SetPrev(m_pXref);
 
+	// The old encryption dictionary is no object of the document's: copied, it
+	// stayed in the file, unreferenced, its strings encrypted a second time.
+	int nEncrypt = -1;
+	Object oEncrypt;
+	if (trailerDict->dictLookupNF("Encrypt", &oEncrypt)->isRef())
+		nEncrypt = oEncrypt.getRefNum();
+	oEncrypt.free();
+
 	for (int i = 0; i < xref->getSize(); ++i)
 	{
 		XRefEntry* pEntry = xref->getEntry(i);
-		if (pEntry->type == xrefEntryFree)
+		if (pEntry->type == xrefEntryFree || i == nEncrypt)
 			continue;
 
 		if (i != pXref->GetSizeXRef())
-- 
