From ab1eeddcc91e225cbe780a0e313b0a1c1c9adb4f Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sfermigier@gmail.com>
Date: Sun, 1 Nov 2026 08:44:43 +0100
Subject: [PATCH] xmlsec: end a certificate's dates on its own day

GetDate wrote the end of a certificate's validity with the day of its
start: valid until 20/11/2027 read 5/11/2027 for one issued on the 5th.
---
 DesktopEditor/xmlsec/src/src/Certificate_openssl.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/DesktopEditor/xmlsec/src/src/Certificate_openssl.h b/DesktopEditor/xmlsec/src/src/Certificate_openssl.h
index ed0aaae38c..ee8ad57256 100644
--- a/DesktopEditor/xmlsec/src/src/Certificate_openssl.h
+++ b/DesktopEditor/xmlsec/src/src/Certificate_openssl.h
@@ -514,7 +514,7 @@ public:
 				"/" +
 				std::to_string(t1.tm_year + 1900) +
 				" - " +
-				std::to_string(t1.tm_mday) +
+				std::to_string(t2.tm_mday) +
 				"/" +
 				std::to_string(t2.tm_mon + 1) +
 				"/" +
-- 
2.55.0

