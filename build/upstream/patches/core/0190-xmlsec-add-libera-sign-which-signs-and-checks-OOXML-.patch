@@ -0,0 +1,44 @@
+cmake_minimum_required(VERSION 3.10)
+
+project(libera-sign)
+
+set(CORE_ROOT_DIR "${CMAKE_CURRENT_LIST_DIR}/../../..")
+
+include(${CORE_ROOT_DIR}/common.cmake)
+
+# Both are made by x2t's library, which the top-level list adds first.
+if(NOT TARGET kernel)
+    add_subdirectory(${CORE_ROOT_DIR}/Common kernel)
+endif()
+
+if(NOT TARGET ooxmlsignature)
+    add_subdirectory(${CORE_ROOT_DIR}/DesktopEditor/xmlsec/src ooxmlsignature)
+endif()
+
+add_executable(libera-sign
+    ${CMAKE_CURRENT_LIST_DIR}/main.cpp
+)
+
+set_default_options(libera-sign)
+
+if( MSVC )
+    target_compile_definitions(libera-sign PRIVATE
+        _UNICODE
+        UNICODE
+    )
+endif()
