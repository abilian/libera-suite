+target_include_directories(libera-sign PRIVATE
+    ${ICU_INSTALL_DIR_ABS}/include
+)
+
+target_link_libraries(libera-sign PRIVATE
+    kernel
+    ooxmlsignature
+    ${LIBICUUC}
+    ${LIBICUDATA}
+)
+
+copy_artifacts_to_folder("libera-sign" "${EO_CORE_OUTPUT_DIR}")
+
+declare_victory( libera-sign )
diff --git a/DesktopEditor/xmlsec/libera-sign/main.cpp b/DesktopEditor/xmlsec/libera-sign/main.cpp
new file mode 100644
index 0000000000..0b65eada31
--- /dev/null
+++ b/DesktopEditor/xmlsec/libera-sign/main.cpp
@@ -0,0 +1,261 @@
+// libera-sign: list, make and remove the digital signatures of an OOXML
+// package, for Libera Suite, which runs it beside x2t. A program because
+// ooxmlsignature has a C++ interface only.
+//
+//   libera-sign verify FILE
+//   libera-sign info KEY CERT
+//   libera-sign sign IN OUT KEY CERT GUID IMAGE-VALID IMAGE-INVALID
+//   libera-sign remove IN OUT GUID
+//   libera-sign certificate FILE INDEX
+//
+// "" stands for an argument not given: CERT when KEY holds the certificate
+// too (PKCS#12, or a PEM with both), GUID for an invisible signature, GUID
+// for every signature in remove. The passphrase of KEY, and of CERT, is the
+// first line of standard input, never an argument, which any process listing
+// would show. Answers are UTF-8 JSON on standard output.
+//
+// Exit status: 0 done, 2 usage, 3 the key or certificate did not load (a
+// wrong passphrase among the reasons), 4 the file could not be read, signed
+// or written.
+
+#include <cstdio>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "../../common/Directory.h"
+#include "../../common/File.h"
+#include "../../../OfficeUtils/src/OfficeUtils.h"
+#include "../src/include/CertificateCommon.h"
+#include "../src/include/OOXMLSigner.h"
+#include "../src/include/OOXMLVerifier.h"
+
+#ifdef _WIN32
+#include <fcntl.h>
+#include <io.h>
+#endif
+
+namespace
+{
+	enum Exit { DONE = 0, USAGE = 2, NO_KEY = 3, FAILED = 4 };
+
+	std::string Utf8(const std::wstring& s)
+	{
+		return NSFile::CUtf8Converter::GetUtf8StringFromUnicode(s);
+	}
+
+	std::string Json(const std::string& s)
+	{
+		std::string out = "\"";
+		for (unsigned char c : s)
+		{
+			if (c == '"' || c == '\\')
+				out += std::string("\\") + (char)c;
+			else if (c < 0x20)
+			{
+				char buffer[8];
+				snprintf(buffer, sizeof(buffer), "\\u%04x", c);
+				out += buffer;
+			}
+			else
+				out += (char)c;
+		}
+		return out + "\"";
+	}
+
+	void Say(const std::string& s)
+	{
+		fwrite(s.data(), 1, s.size(), stdout);
+		fputc('\n', stdout);
+	}
+
+	std::string ReadPassphrase()
+	{
+		std::string line;
+		std::getline(std::cin, line);
+		if (!line.empty() && line.back() == '\r')
+			line.pop_back();
+		return line;
+	}
+
+	bool Read(const std::wstring& path, std::vector<BYTE>& data)
+	{
+		BYTE* bytes = NULL;
+		DWORD length = 0;
+		if (!NSFile::CFileBinary::ReadAllBytes(path, &bytes, length) || !bytes)
+			return false;
+		data.assign(bytes, bytes + length);
+		RELEASEARRAYOBJECTS(bytes);
+		return !data.empty();
+	}
+
+	bool Write(const std::wstring& path, const BYTE* data, DWORD length)
+	{
+		NSFile::CFileBinary file;
+		bool written = file.CreateFileW(path) && file.WriteFile(data, length);
+		file.CloseFile();
+		return written;
+	}
+
+	ICertificate* Load(const std::wstring& key, const std::wstring& cert)
+	{
+		std::string passphrase = ReadPassphrase();
+		return NSCertificate::FromFiles(key, passphrase, cert, cert.empty() ? "" : passphrase);
+	}
+
+	std::string Describe(ICertificate* cert)
+	{
+		return "{\"name\":" + Json(Utf8(cert->GetSignerName())) +
+			",\"issuer\":" + Json(Utf8(cert->GetIssuerName())) +
+			",\"date\":" + Json(cert->GetDate()) + "}";
+	}
+
+	int Verify(const std::wstring& path)
+	{
+		std::vector<BYTE> data;
+		if (!Read(path, data))
+			return FAILED;
+		COOXMLVerifier verifier(data.data(), (unsigned long)data.size());
+		int count = verifier.GetSignatureCount();
+		// The shape DesktopOfflineAppDocumentSignatures reads (sdkjs
+		// common/Local/common.js), with the signer's certificate besides.
+		std::string out = "{\"count\":" + std::to_string(count) + ",\"data\":[";
+		for (int i = 0; i < count; ++i)
+		{
+			COOXMLSignature* signature = verifier.GetSignature(i);
+			ICertificate* cert = signature->GetCertificate();
+			out += std::string(i ? "," : "") +
+				"{\"guid\":" + Json(signature->GetGuid()) +
+				",\"valid\":" + std::to_string(signature->GetValid()) +
+				",\"name\":" + Json(cert ? Utf8(cert->GetSignerName()) : "") +
+				",\"date\":" + Json(signature->GetDate()) +
+				",\"image_valid\":" + Json(signature->GetImageValidBase64()) +
+				",\"image_invalid\":" + Json(signature->GetImageInvalidBase64()) +
+				",\"certificate\":" + (cert ? Describe(cert) : "null") + "}";
+		}
+		Say(out + "]}");
+		return DONE;
+	}
+
+	int Info(const std::wstring& key, const std::wstring& certPath)
+	{
+		ICertificate* cert = Load(key, certPath);
+		if (!cert)
+			return NO_KEY;
+		Say(Describe(cert));
+		delete cert;
+		return DONE;
+	}
+
+	int Sign(const std::vector<std::wstring>& a)
+	{
+		const std::wstring &in = a[0], &out = a[1], &key = a[2], &certPath = a[3],
+			&guid = a[4], &imageValid = a[5], &imageInvalid = a[6];
+		ICertificate* cert = Load(key, certPath);
+		if (!cert)
+			return NO_KEY;
+		std::vector<BYTE> data;
+		if (!Read(in, data))
+		{
+			delete cert;
+			return FAILED;
+		}
+		// The pictures by their bytes: given a name, the signer reads a file of
+		// the package's own, not one on disk.
+		std::vector<BYTE> valid, invalid;
+		if ((!imageValid.empty() && !Read(imageValid, valid)) ||
+			(!imageInvalid.empty() && !Read(imageInvalid, invalid)))
+		{
+			delete cert;
+			return FAILED;
+		}
+		COOXMLSigner signer(data.data(), (unsigned long)data.size(), cert);
+		if (!guid.empty())
+			signer.SetGuid(guid);
+		if (!valid.empty())
+			signer.SetImageValid(valid.data(), (DWORD)valid.size());
+		if (!invalid.empty())
+			signer.SetImageInvalid(invalid.data(), (DWORD)invalid.size());
+		unsigned char* signedData = NULL;
+		unsigned long length = 0;
+		signer.Sign(signedData, length);
+		bool written = signedData && length && Write(out, signedData, (DWORD)length);
+		RELEASEARRAYOBJECTS(signedData);
+		delete cert;
+		return written ? DONE : FAILED;
+	}
+
+	int Remove(const std::wstring& in, const std::wstring& out, const std::string& guid)
+	{
+		// On a folder: on bytes in memory, the verifier keeps the result.
+		std::wstring folder = NSDirectory::CreateDirectoryWithUniqueName(NSFile::CFileBinary::GetTempPath());
+		COfficeUtils zip;
+		bool done = !folder.empty() && S_OK == zip.ExtractToDirectory(in, folder, NULL, 0);
+		if (done)
+		{
+			COOXMLVerifier verifier(folder);
+			verifier.RemoveSignature(guid);
+			done = S_OK == zip.CompressFileOrDirectory(folder, out, true);
+		}
+		if (!folder.empty())
+			NSDirectory::DeleteDirectory(folder);
+		return done ? DONE : FAILED;
+	}
+
+	int Certificate(const std::wstring& path, int index)
+	{
+		std::vector<BYTE> data;
+		if (!Read(path, data))
+			return FAILED;
+		COOXMLVerifier verifier(data.data(), (unsigned long)data.size());
+		COOXMLSignature* signature = index >= 0 && index < verifier.GetSignatureCount()
+			? verifier.GetSignature(index) : NULL;
+		ICertificate* cert = signature ? signature->GetCertificate() : NULL;
+		if (!cert)
+			return FAILED;
+		// Printed by OpenSSL whatever read it: on Windows the verifier reads
+		// certificates with CryptoAPI, whose Print answers "".
+		ICertificate* printer = NSCertificate::CreateInstance(CERTIFICATE_ENGINE_TYPE_OPENSSL);
+		std::string text = printer && printer->LoadFromBase64Data(cert->GetCertificateBase64())
+			? printer->Print() : "";
+		delete printer;
+		Say("{\"certificate\":" + Describe(cert) + ",\"text\":" + Json(text) + "}");
+		return DONE;
+	}
+
+	int Run(const std::vector<std::wstring>& args)
+	{
+		if (args.empty())
+			return USAGE;
+		const std::wstring& command = args[0];
+		std::vector<std::wstring> a(args.begin() + 1, args.end());
+		if (command == L"verify" && a.size() == 1)
+			return Verify(a[0]);
+		if (command == L"info" && a.size() == 2)
+			return Info(a[0], a[1]);
+		if (command == L"sign" && a.size() == 7)
+			return Sign(a);
+		if (command == L"remove" && a.size() == 3)
+			return Remove(a[0], a[1], Utf8(a[2]));
+		if (command == L"certificate" && a.size() == 2)
+			return Certificate(a[0], std::stoi(a[1]));
+		return USAGE;
+	}
+}
+
+#ifdef _WIN32
+int wmain(int argc, wchar_t** argv)
+{
+	_setmode(_fileno(stdout), _O_BINARY);
+	std::vector<std::wstring> args(argv + 1, argv + argc);
+	return Run(args);
+}
+#else
+int main(int argc, char** argv)
+{
+	std::vector<std::wstring> args;
+	for (int i = 1; i < argc; ++i)
+		args.push_back(NSFile::CUtf8Converter::GetUnicodeStringFromUTF8((BYTE*)argv[i], (LONG)strlen(argv[i])));
+	return Run(args);
+}
+#endif
-- 
