From bf919d32c60c73175d0b2e409c6b574ba4ab515a Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Mon, 16 Nov 2026 19:38:39 +0100
Subject: [PATCH] ODS: a large sheet's cell styles are resolved once, not once
 a cell

Each cell looked its styles up by a key that printed the style family
through a stream, and recomputed its text, paragraph and cell properties
from the same few styles. The family names are now printed once, a
lookup of no name outside the common styles returns at once, and the
properties of each combination of styles are kept by the document's
read context. A 10-sheet workbook converts in 1.8 s instead of 5.1, its
output unchanged.
---
 OdfFile/Reader/Format/calcs_styles.cpp | 21 ++++++++++++++++++
 OdfFile/Reader/Format/calcs_styles.h   | 19 ++++++++++++++++
 OdfFile/Reader/Format/odfcontext.cpp   | 30 +++++++++++++++++++++-----
 OdfFile/Reader/Format/odfcontext.h     |  5 +++++
 OdfFile/Reader/Format/table_xlsx.cpp   |  7 +++---
 5 files changed, 74 insertions(+), 8 deletions(-)

diff --git a/OdfFile/Reader/Format/calcs_styles.cpp b/OdfFile/Reader/Format/calcs_styles.cpp
index 62bbd5300e..9245062d75 100644
--- a/OdfFile/Reader/Format/calcs_styles.cpp
+++ b/OdfFile/Reader/Format/calcs_styles.cpp
@@ -259,5 +259,26 @@ style_table_cell_properties_attlist calc_table_cell_properties(const std::vector
     return result;
 }
 
+const cell_style_properties & cell_style_cache::get(const std::vector<const style_instance *> & styleInstances)
+{
+	std::map<std::vector<const style_instance *>, cell_style_properties>::iterator found = cache_.find(styleInstances);
+	if (found != cache_.end())
+		return found->second;
+
+	cell_style_properties & properties = cache_[styleInstances];
+	properties.text			= calc_text_properties_content(styleInstances);
+	properties.paragraph	= calc_paragraph_properties_content(styleInstances);
+	properties.cell			= calc_table_cell_properties(styleInstances);
+	return properties;
+}
+
+const cell_style_properties & calc_cell_style_properties(odf_read_context & context, const std::vector<const style_instance *> & styleInstances)
+{
+	boost::shared_ptr<cell_style_cache> & cache = context.cellStyleCache();
+	if (!cache)
+		cache = boost::make_shared<cell_style_cache>();
+	return cache->get(styleInstances);
+}
+
 }
 }
diff --git a/OdfFile/Reader/Format/calcs_styles.h b/OdfFile/Reader/Format/calcs_styles.h
index 6672843ee1..62b2b2f404 100644
--- a/OdfFile/Reader/Format/calcs_styles.h
+++ b/OdfFile/Reader/Format/calcs_styles.h
@@ -32,6 +32,7 @@
 
 #include "odfcontext.h"
 #include <vector>
+#include <map>
 
 namespace cpdoccore 
 { 
@@ -53,6 +54,24 @@ namespace cpdoccore
 		style_table_cell_properties_attlist calc_table_cell_properties(const style_instance * styleInstance);
 		style_table_cell_properties_attlist calc_table_cell_properties(const std::vector<const style_instance *> & styleInstances);
 
+		// A cell's text, paragraph and cell properties, from the styles it takes them from. A large sheet
+		// asks for the same few combinations once a cell, and computing them was most of its conversion:
+		// they are kept by the document's read context, whose styles do not change once read.
+		struct cell_style_properties
+		{
+			text_format_properties_ptr			text;
+			paragraph_format_properties			paragraph;
+			style_table_cell_properties_attlist	cell;
+		};
+		class cell_style_cache
+		{
+		public:
+			const cell_style_properties & get(const std::vector<const style_instance *> & styleInstances);
+		private:
+			std::map<std::vector<const style_instance *>, cell_style_properties> cache_;
+		};
+		const cell_style_properties & calc_cell_style_properties(odf_read_context & context, const std::vector<const style_instance *> & styleInstances);
+
 		void calc_tab_stops(const style_instance * styleInstance, oox::tabs_context & context);
 		_CP_OPT(int) calc_outline_level(_CP_OPT(int) value, const style_instance * styleInstance);
 	}
diff --git a/OdfFile/Reader/Format/odfcontext.cpp b/OdfFile/Reader/Format/odfcontext.cpp
index b8d5e1bd40..844693b91c 100644
--- a/OdfFile/Reader/Format/odfcontext.cpp
+++ b/OdfFile/Reader/Format/odfcontext.cpp
@@ -47,6 +47,21 @@ namespace cpdoccore {
 	}
 	namespace odf_reader {
 
+		// The family's part of a style's key, printed once a family: a lookup
+		// is made for every cell, and printing it through a stream each time
+		// was a third of the time a large spreadsheet took to convert.
+		static const std::wstring& family_name(style_family::type Type)
+		{
+			static const std::vector<std::wstring> names = []
+			{
+				std::vector<std::wstring> v;
+				for (int t = style_family::None; t <= style_family::LineNumbering; ++t)
+					v.push_back(boost::lexical_cast<std::wstring>(style_family(static_cast<style_family::type>(t))));
+				return v;
+			}();
+			return names.at(Type);
+		}
+
 		style_instance::style_instance(
 			styles_container* Container,
 			const std::wstring& Name,
@@ -126,7 +141,7 @@ namespace cpdoccore {
 
 			if (!Name.empty())
 			{
-				std::wstring n = Name + L":" + boost::lexical_cast<std::wstring>(style_family(Type));
+				std::wstring n = Name + L":" + family_name(Type);
 				map_[n] = pos;
 
 				// TODO: which is correct??
@@ -138,7 +153,7 @@ namespace cpdoccore {
 
 			if (!DisplayName.empty())
 			{
-				std::wstring n = DisplayName + L":" + boost::lexical_cast<std::wstring>(style_family(Type));
+				std::wstring n = DisplayName + L":" + family_name(Type);
 				map2_[n] = pos;
 			}
 
@@ -231,9 +246,14 @@ namespace cpdoccore {
 
 		style_instance* styles_container::style_by_name(const std::wstring& Name, style_family::type Type, bool object_in_styles) const
 		{
+			// add_style registers no empty name but a common style's ("common:"): a cell without a row or
+			// column style asks for "" twice, and the key would be built for nothing
+			if (Name.empty() && !object_in_styles)
+				return NULL;
+
 			std::wstring n = L"";
 			if (object_in_styles) n = L"common:";
-			n = n + Name + L":" + boost::lexical_cast<std::wstring>(style_family(Type));
+			n = n + Name + L":" + family_name(Type);
 
 			map_wstring_int_t::const_iterator res = map_.find(n);
 
@@ -245,7 +265,7 @@ namespace cpdoccore {
 			else if (object_in_styles)
 			{
 				//try automatic
-				n = Name + L":" + boost::lexical_cast<std::wstring>(style_family(Type));
+				n = Name + L":" + family_name(Type);
 
 				map_wstring_int_t::const_iterator res = map_.find(n);
 
@@ -261,7 +281,7 @@ namespace cpdoccore {
 		{
 			std::wstring n = L"";
 			if (object_in_styles) n = L"common:";
-			n = n + Name + L":" + boost::lexical_cast<std::wstring>(style_family(Type));
+			n = n + Name + L":" + family_name(Type);
 
 			map_wstring_int_t::const_iterator res = map2_.find(n);
 
