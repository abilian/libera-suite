 OOXML/Common/ChartExDetect.h                  | 50 +++++++++++++++++++
 OOXML/DocxFormat/FileFactory.cpp              |  6 +++
 OOXML/PPTXFormat/Logic/SmartArt.cpp           | 12 +++++
 OOXML/PPTXFormat/Logic/SmartArt.h             |  3 ++
 5 files changed, 77 insertions(+), 1 deletion(-)
 create mode 100644 OOXML/Common/ChartExDetect.h

