From dc04266b509a21806a2c33483ec10cfab9193726 Mon Sep 17 00:00:00 2001
From: Stefane Fermigier <sf@abilian.com>
Date: Thu, 19 Nov 2026 13:16:28 +0100
Subject: [PATCH] v8: let LLD_DIR name the lld to link with on macOS

LLVM_DIR already names the LLVM; lld is a formula of its own, and on a
macOS Homebrew no longer builds bottles for, the current lld needs the
current LLVM built from source, which fails there. A versioned keg
(lld@21) that has a bottle can now be named instead.
---
 Common/3dParty/v8/nc-build.py | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/Common/3dParty/v8/nc-build.py b/Common/3dParty/v8/nc-build.py
index 778436f4e2..9f9a6ef6e9 100644
--- a/Common/3dParty/v8/nc-build.py
+++ b/Common/3dParty/v8/nc-build.py
@@ -298,10 +298,14 @@ def _find_mac_llvm_bin_dir() -> Path:
     return llvm_dir / "bin"
 
 def mac_lld_bin_dir() -> Path:
-    for candidate in ( _find_mac_llvm_bin_dir(), ( _homebrew_prefix( "lld" ) or Path( "/nonexistent" ) ) / "bin" ):
+    # LLD_DIR, like LLVM_DIR, for an lld outside these: a versioned keg such
+    # as lld@21, where Homebrew has no bottle of the current lld for this macOS
+    candidates = [ Path( os.environ[ "LLD_DIR" ] ) / "bin" ] if os.environ.get( "LLD_DIR" ) else []
+    candidates += [ _find_mac_llvm_bin_dir(), ( _homebrew_prefix( "lld" ) or Path( "/nonexistent" ) ) / "bin" ]
+    for candidate in candidates:
         if ( candidate / "ld64.lld" ).exists():
             return candidate
-    nc.abort_op( "V8 on macOS needs lld: brew install lld" )
+    nc.abort_op( "V8 on macOS needs lld: brew install lld (or set LLD_DIR)" )
 
 def prepare_android_clang_base() -> tuple[ Path, str ]:
     # The NDK's clang. It also builds the host tools (mksnapshot, torque) for
-- 
