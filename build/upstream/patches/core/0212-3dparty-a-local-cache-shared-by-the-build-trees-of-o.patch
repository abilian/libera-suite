@@ -135,6 +135,24 @@ class RemoteCacheTest( unittest.TestCase ):
             "Signature=34b48302e7b5fa45bde8084f4b7868a86f0a534bc59db6670ed5711ef69dc6f7" ) )
 
 
+class LocalBackendTest( unittest.TestCase ):
+    def test_an_archive_put_is_found_listed_and_got_back( self ):
+        with tempfile.TemporaryDirectory() as tmp:
+            root, src, dest = Path( tmp ) / "cache", Path( tmp ) / "v8.tar.bz2", Path( tmp ) / "back"
+            src.write_bytes( b"archive" )
+            cache = remote_cache.LocalBackend( root )
+            path = "3rdparty/linux-x86_64/v8/14.6/v8-glibc2.35.tar.bz2"
+            self.assertFalse( cache.exists( path ) )
+            self.assertFalse( cache.get( path, dest ) )
+            self.assertTrue( cache.put( src, path ) )
+            self.assertTrue( cache.exists( path ) )
+            self.assertIn( "v8-glibc2.35.tar.bz2", cache.list( "3rdparty/linux-x86_64/v8/14.6" ) )
+            self.assertEqual( cache.list( "3rdparty/nothing" ), "" )
+            self.assertTrue( cache.get( path, dest ) )
+            self.assertEqual( dest.read_bytes(), b"archive" )
+            self.assertEqual( list( ( root / path ).parent.glob( "*.partial" ) ), [] )
+
+
