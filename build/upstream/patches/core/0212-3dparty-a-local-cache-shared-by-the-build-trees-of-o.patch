+        print( "  [WARN]  REMOTE_CACHE_TYPE local needs REMOTE_CACHE_DIR, cache disabled" )
 elif REMOTE_CACHE_TYPE == "nextcloud":
     USE_REMOTE_CACHE = bool( ( NEXTCLOUD_USER and NEXTCLOUD_PASS )
                              or _env( "NEXTCLOUD_REMOTE" ) )
@@ -522,7 +531,9 @@ _backend_instance = None
 def _backend():
     global _backend_instance
     if _backend_instance is None:
-        if REMOTE_CACHE_TYPE == "s3":
+        if REMOTE_CACHE_TYPE == "local":
+            _backend_instance = remote_cache.LocalBackend( _env( "REMOTE_CACHE_DIR" ) )
+        elif REMOTE_CACHE_TYPE == "s3":
             _backend_instance = remote_cache.S3Backend( S3_URL, S3_REGION, S3_ACCESS_KEY,
                                                         S3_SECRET_KEY, S3_SESSION_TOKEN )
         else:
@@ -594,6 +605,10 @@ def ensure_dep( build_fn, forceredo=None ):
     #    a forced redo, so this correctly does NOT skip in that case.
     if install_dir_looks_ok():
         print( f"  [OK] { name } already present locally, skipping" )
+        # A local cache keeps what this tree has, for the next tree here.
+        if REMOTE_CACHE_TYPE == "local" and USE_REMOTE_CACHE and _remote_upload_needed():
+            print( f"  [PUT]  Keeping { name } in the local cache..." )
+            _remote_upload()
         return
 
