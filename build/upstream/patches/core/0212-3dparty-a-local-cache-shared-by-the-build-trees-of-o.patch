diff --git a/scripts/remote_cache.py b/scripts/remote_cache.py
index 3f0ad1ffa4..616a1dcc47 100644
--- a/scripts/remote_cache.py
+++ b/scripts/remote_cache.py
@@ -22,6 +22,7 @@ import os
 import re
 import shutil
 import subprocess
+from pathlib import Path
 
 DEFAULT_S3_URL = "https://s3.eu-central-4.ionoscloud.com/eo-build-assets"
 DEFAULT_NEXTCLOUD_REMOTE = "https://cloud.nextcloud.com/remote.php/dav/files"
@@ -101,6 +102,48 @@ class WebDavBackend:
         return self._curl( "-f", "-X", "DELETE", self._url( path ) ).returncode == 0
 
 
+class LocalBackend:
+    # A directory on this machine: the cache shared by every build tree here,
+    # with the same archive paths as the remote ones. Files are written to a
+    # temporary name and renamed, so a build stopped half-way never leaves an
+    # archive another build would take for whole.
+
+    def __init__( self, root ):
+        self.root = Path( root )
+
+    def exists( self, path ):
+        return ( self.root / path ).is_file()
+
+    def list( self, dir ):
+        folder = self.root / dir
+        return "\n".join( sorted( p.name for p in folder.iterdir() ) ) if folder.is_dir() else ""
+
+    def keys( self, dir ):
+        folder = self.root / dir
+        return sorted( f"{ dir }/{ p.name }" for p in folder.iterdir() ) if folder.is_dir() else []
+
+    def read( self, path ):
+        return ( self.root / path ).read_bytes()
+
+    def get( self, path, dest_file ):
+        if not self.exists( path ):
+            return False
+        shutil.copyfile( self.root / path, dest_file )
+        return True
+
+    def put( self, src_file, path ):
+        target = self.root / path
+        target.parent.mkdir( parents=True, exist_ok=True )
+        partial = target.with_name( target.name + ".partial" )
+        shutil.copyfile( src_file, partial )
+        os.replace( partial, target )
+        return True
+
+    def delete( self, path ):
+        ( self.root / path ).unlink( missing_ok=True )
+        return True
+
+
 class S3Backend:
     # Plain urllib + AWS Signature V4, so no boto3 / aws cli is needed.
     # Path-style requests against <endpoint>/<bucket>. Without credentials,
