+# Local, a directory shared by the build trees of one machine:
+#   REMOTE_CACHE_DIR        The directory. A dependency built or already present
+#                           in a tree is stored there, so that the next tree on
+#                           this machine takes it instead of building it again.
+#
 # Nextcloud / WebDAV ('curl' must be on PATH):
 #   NEXTCLOUD_REMOTE        WebDAV root (default
 #                           "https://cloud.nextcloud.com/remote.php/dav/files").
@@ -423,6 +428,10 @@ if REMOTE_CACHE_TYPE == "s3":
         print( "  [WARN]  REMOTE_CACHE_S3_URL must look like https://<endpoint>/<bucket>, remote cache disabled" )
     if not ( S3_ACCESS_KEY and S3_SECRET_KEY ):
