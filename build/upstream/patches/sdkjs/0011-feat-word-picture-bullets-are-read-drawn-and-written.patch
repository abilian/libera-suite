 /**
  * Заполняем специальный класс для работы с интерфейсом
@@ -1257,6 +1267,9 @@ CNumberingLvl.prototype.FillToAscNumberingLvl = function(oAscLvl)
  */
 CNumberingLvl.prototype.FillFromAscNumberingLvl = function(oAscLvl)
 {
