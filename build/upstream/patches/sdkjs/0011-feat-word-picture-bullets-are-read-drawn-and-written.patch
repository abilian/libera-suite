 word/Editor/Serialize2.js             | 102 +++++++++++++++++++++++++-
 word/fromToJSON.js                    |   6 ++
 5 files changed, 318 insertions(+), 6 deletions(-)

diff --git a/word/Editor/Numbering/Num.js b/word/Editor/Numbering/Num.js
index 0eb09a0cd1..88c3f0d8c3 100644
--- a/word/Editor/Numbering/Num.js
+++ b/word/Editor/Numbering/Num.js
@@ -520,6 +520,82 @@ CNum.prototype.private_GetNumberedLvlText = function(nLvl, nNumShift, isForceAra
 
 	return AscCommon.IntToNumberFormat(nNumShift, nFormat, {lang: oLangForTextNumbering});
 };
+/**
+ * Get the picture of the bullet of the given level. Returns null (the text bullet must be used) if the level has no
+ * picture bullet or the picture is unknown or not loaded (yet)
+ * @param oLvl {CNumberingLvl}
+ * @returns {?{Url : string, Ratio : number}} Url is the key of the image in the image loader, Ratio is width / height
+ */
+CNum.prototype.private_GetPicBullet = function(oLvl)
+{
+	if (undefined === oLvl.PicBulletId || !this.Numbering || !this.Numbering.GetPicBullet)
+		return null;
+	
+	let picBullet = this.Numbering.GetPicBullet(oLvl.PicBulletId);
+	if (!picBullet || !picBullet.Image)
+		return null;
+	
+	let url = AscCommon.getFullImageSrc2(picBullet.Image);
+	
+	// x2t's renderer, which prints and exports to PDF, has no image loader to
+	// ask: it draws a picture from its address, as it does every other one,
+	// and the bullet takes its proportions from the numbering's size of it.
+	if (window["NATIVE_EDITOR_ENJINE"])
+	{
+		let ratio = picBullet.Width > 0 && picBullet.Height > 0 ? picBullet.Width / picBullet.Height : 1;
+		return {Url : url, Ratio : ratio, Entry : picBullet, ImageHeightPx : 0};
+	}
+	
+	let api = Asc.editor || editor;
+	if (!api || !api.ImageLoader || !api.ImageLoader.map_image_index)
+		return null;
+	
+	let img = api.ImageLoader.map_image_index[url];
+	if (!img || !img.Image || img.Status === AscFonts.ImageLoadStatus.Loading)
+		return null;
+	
+	let w = img.Image.width;
+	let h = img.Image.height;
+	if (!(w > 0 && h > 0))
+	{
+		// The size of the picture in the numbering definition is the fallback
+		w = picBullet.Width;
+		h = picBullet.Height;
+	}
+	
+	if (!(w > 0 && h > 0))
+		return null;
+	
+	return {Url : url, Ratio : w / h, Entry : picBullet, ImageHeightPx : img.Image.height > 0 ? img.Image.height : 0};
+};
+/**
+ * Height of the picture bullet in mm. Word draws the picture with the height
+ * (font size - 2) * shapeHeightPt / naturalHeightPt, where naturalHeightPt is the image pixel height * 0.75 (96 dpi)
+ * and shapeHeightPt is the height of the v:shape from the file; if the shape height or the image pixel height is
+ * missing or not positive the factor is 1. The height is never below 1 pt.
+ * @param oNumTextPr {CTextPr}
+ * @param dKoef {number}
+ * @param picBullet {{Entry : {Height : number}, ImageHeightPx : number}} result of private_GetPicBullet
+ * @returns {number}
+ */
+CNum.prototype.private_GetPicBulletHeight = function(oNumTextPr, dKoef, picBullet)
+{
+	var nBase = oNumTextPr.FontSize - 2;
+	if (!(nBase >= 1))
+		nBase = 1;
+	
+	var nShapeH = picBullet && picBullet.Entry ? picBullet.Entry.Height : 0;
+	var nImgH   = picBullet ? picBullet.ImageHeightPx : 0;
+	var nFactor = 1;
+	if (nShapeH > 0 && nImgH > 0)
+		nFactor = nShapeH / (nImgH * 0.75);
+	
+	var nHeightPt = nBase * nFactor;
+	if (!(nHeightPt >= 1))
+		nHeightPt = 1;
+	
+	return nHeightPt * dKoef * g_dKoef_pt_to_mm;
+};
 /**
  * Функция отрисовки заданного уровня нумерации в заданной позиции
  * @param nX
@@ -537,6 +613,14 @@ CNum.prototype.Draw = function(nX, nY, oContext, nLvl, oNumInfo, oNumTextPr, oTh
 	var arrText = oLvl.GetLvlText();
 	var dKoef   = oNumTextPr.VertAlign !== AscCommon.vertalign_Baseline ? AscCommon.vaKSize : 1;
 	
+	let picBullet = this.private_GetPicBullet(oLvl);
+	if (picBullet && oContext.drawImage && !(oContext.isTextDrawer && oContext.isTextDrawer()))
+	{
+		let picH = this.private_GetPicBulletHeight(oNumTextPr, dKoef, picBullet);
+		oContext.drawImage(picBullet.Url, nX, nY - picH, picH * picBullet.Ratio, picH);
+		return;
+	}
+	
 	oContext.SetTextPr(oNumTextPr, oTheme);
 	g_oTextMeasurer.SetTextPr(oNumTextPr, oTheme);
 	
@@ -598,6 +682,15 @@ CNum.prototype.Measure = function(oContext, nLvl, oNumInfo, oNumTextPr, oTheme)
 	oContext.SetTextPr(oNumTextPr, oTheme);
 	oContext.SetFontSlot(AscWord.fontslot_ASCII, dKoef);
 	var nAscent = oContext.GetAscender();
+	
+	let picBullet = this.private_GetPicBullet(oLvl);
+	if (picBullet)
+	{
+		return {
+			Width  : this.private_GetPicBulletHeight(oNumTextPr, dKoef, picBullet) * picBullet.Ratio,
+			Ascent : nAscent
+		};
+	}
 
 	for (var nTextIndex = 0, nTextLen = arrText.length; nTextIndex < nTextLen; ++nTextIndex)
 	{
diff --git a/word/Editor/Numbering/Numbering.js b/word/Editor/Numbering/Numbering.js
index dd628d3a3c..420aae866a 100644
--- a/word/Editor/Numbering/Numbering.js
+++ b/word/Editor/Numbering/Numbering.js
@@ -37,7 +37,73 @@
 		this.Num         = {};
 		
 		this.AbstractNumByNsid = {};
+		
+		// Pictures used as bullets (w:numPicBullet): id -> {Image : string, Width : number (pt), Height : number (pt)}
+		// Image is the name of the media file as written in the binary document (e.g. "image1.png")
+		this.PicBullets = {};
 	}
+	
+	/**
+	 * Is there any picture bullet in the document
+	 * @returns {boolean}
+	 */
+	CNumbering.prototype.HasPicBullets = function()
+	{
+		for (let id in this.PicBullets)
+		{
+			if (this.PicBullets.hasOwnProperty(id))
+				return true;
+		}
+		return false;
+	};
+	/**
+	 * @returns {Object} id -> {Image, Width, Height}
+	 */
+	CNumbering.prototype.GetPicBullets = function()
+	{
+		return this.PicBullets;
+	};
+	/**
+	 * Get description of the picture bullet by its id
+	 * @param id {number}
+	 * @returns {?{Image : string, Width : number, Height : number}}
+	 */
+	CNumbering.prototype.GetPicBullet = function(id)
+	{
+		if (undefined === id || null === id || !this.PicBullets.hasOwnProperty(id))
+			return null;
+		
+		return this.PicBullets[id];
+	};
+	/**
+	 * Register a picture bullet. If the same picture is already registered, its id is returned. If the requested id
+	 * is occupied by another picture, a new id is chosen.
+	 * @param id {number} wanted id
+	 * @param image {string} name of the media file
+	 * @param width {number} pt, 0 if unknown
+	 * @param height {number} pt, 0 if unknown
+	 * @returns {number} the id to use
+	 */
+	CNumbering.prototype.AddPicBullet = function(id, image, width, height)
+	{
+		let maxId = -1;
+		for (let curId in this.PicBullets)
+		{
+			if (!this.PicBullets.hasOwnProperty(curId))
+				continue;
+			
+			if (this.PicBullets[curId].Image === image)
+				return parseInt(curId, 10);
+			
+			maxId = Math.max(maxId, parseInt(curId, 10));
+		}
+		
+		if (this.PicBullets.hasOwnProperty(id))
+			id = maxId + 1;
+		
+		this.PicBullets[id] = {Image : image, Width : width, Height : height};
+		return id;
+	};
 
 	/**
 	 * Копируем все нумерации и абстрактные нумерации. Возвращаем новые объекты с мапом из старых Id в новые
@@ -82,6 +148,31 @@
 			oNewNums[sNewId] = oNewNum;
 			oNumMap[sOldId]  = sNewId;
 		}
+		
+		// The ids of the picture bullets belong to the numbering of the source document. The pictures are not
+		// transferred to another document, so the copies use their text bullets
+		if (oNumbering !== this && this.HasPicBullets())
+		{
+			for (var sNewAbstractId in oNewAbstractNums)
+			{
+				var arrLvls = oNewAbstractNums[sNewAbstractId].Lvl;
+				for (var nLvlIndex = 0; arrLvls && nLvlIndex < arrLvls.length; ++nLvlIndex)
+				{
+					if (arrLvls[nLvlIndex])
+						arrLvls[nLvlIndex].PicBulletId = undefined;
+				}
+			}
+			
+			for (var sNewNumId in oNewNums)
+			{
+				for (var nOverrideLvl = 0; nOverrideLvl < 9; ++nOverrideLvl)
+				{
+					var oOverride = oNewNums[sNewNumId].LvlOverride[nOverrideLvl];
+					if (oOverride && oOverride.NumberingLvl)
+						oOverride.NumberingLvl.PicBulletId = undefined;
+				}
+			}
+		}
 
 		return {
 			AbstractNum : oNewAbstractNums,
