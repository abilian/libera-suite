 	if (undefined !== oAscLvl.get_Format())
 		this.SetFormat(oAscLvl.get_Format());
 
@@ -1460,7 +1473,8 @@ CNumberingLvl.prototype.WriteToBinary = function(oWriter)
 	// Array of variables : массив LvlText
 	// Bool               : true -> CNumberingLegacy
 	//                    : false -> Legacy = undefined
-	// Bool               : IsLgl
+	// Byte               : IsLgl in bit 0; bit 1 set -> a Long PicBulletId follows
+	// Long               : PicBulletId, only if bit 1 is set
 
 	oWriter.WriteLong(this.Jc);
 	oWriter.WriteLong(this.Format);
@@ -1490,7 +1504,12 @@ CNumberingLvl.prototype.WriteToBinary = function(oWriter)
 		oWriter.WriteBool(false);
 	}
 
-	oWriter.WriteBool(this.IsLgl);
+	// IsLgl was a Bool, a byte of 0 or 1 that ended the level. Its bit 1 says a
+	// picture bullet follows, so a change log written before picture bullets,
+	// in a session recovered by a newer build, still reads as it did.
+	oWriter.WriteByte((this.IsLgl ? 1 : 0) | (undefined !== this.PicBulletId ? 2 : 0));
+	if (undefined !== this.PicBulletId)
+		oWriter.WriteLong(this.PicBulletId);
 };
 CNumberingLvl.prototype.ReadFromBinary = function(oReader)
 {
@@ -1506,7 +1525,8 @@ CNumberingLvl.prototype.ReadFromBinary = function(oReader)
 	// Array of variables : массив LvlText
 	// Bool               : true -> CNumberingLegacy
 	//                    : false -> Legacy = undefined
-	// Bool               : IsLgl
+	// Byte               : IsLgl in bit 0; bit 1 set -> a Long PicBulletId follows
+	// Long               : PicBulletId, only if bit 1 is set
 
 
 	this.Jc     = oReader.GetLong();
@@ -1540,7 +1560,9 @@ CNumberingLvl.prototype.ReadFromBinary = function(oReader)
 		this.Legacy.ReadFromBinary(oReader);
 	}
 
-	this.IsLgl = oReader.GetBool();
+	let nLglByte = oReader.GetUChar();
+	this.IsLgl = !!(nLglByte & 1);
+	this.PicBulletId = (nLglByte & 2) ? oReader.GetLong() : undefined;
 };
 CNumberingLvl.prototype.private_ReadLvlTextFromBinary = function(oReader)
 {
