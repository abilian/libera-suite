From 15f127ac57ceb1fe0d45d0d9c4169c820d011efb Mon Sep 17 00:00:00 2001
From: Libera build <build@libera.invalid>
Date: Thu, 5 Nov 2026 18:41:03 +0100
Subject: [PATCH] fix: a dialog's Close file closes the window

Removing goback from the desktop page took the button away, and also
what Common.Controllers.Desktop.requestClose reads: the password
dialog's "Close file" threw, the error became "An error has occurred
while opening the file", and its OK threw again. An empty goback shows
no button either.
---
 apps/api/documents/index.html.desktop | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/apps/api/documents/index.html.desktop b/apps/api/documents/index.html.desktop
index 9bd3817ea6..db8a86526d 100644
--- a/apps/api/documents/index.html.desktop
+++ b/apps/api/documents/index.html.desktop
@@ -111,6 +111,10 @@
                         // a folder a desktop app does not have.
                         features: { featuresTips: false }
                         , feedback: false
+                        // No url, so no button, but it must be there: a dialog
+                        // that closes the window, such as a password's "Close
+                        // file", reads goback.url on the way.
+                        , goback: {}
                         // Macros here are JavaScript against the editor's own
                         // API: they run none of the VBA a document from
                         // Microsoft Office carries. Off until there is a
-- 
